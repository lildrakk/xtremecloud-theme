FOLDER: xtremecloud-theme
========================================

FILE: plugin.json
----------------------------------------
{
  "name": "XtremeCloud Theme PRO",
  "version": "2.0.0",
  "description": "Professional theme customizer for Pelican with live preview, fonts, colors, CSS and branding.",
  "author": "Juan",
  "entry": "index.html",
  "id": "xtremecloud-theme-pro"
}

FILE: index.html
----------------------------------------
<!DOCTYPE html>
<html>
<head>
  <title>XtremeCloud Theme PRO</title>
  <link rel="stylesheet" href="theme.css">
  <link id="googleFont" rel="stylesheet" href="">
</head>

<body>

<h1>XtremeCloud Theme PRO</h1>

<div class="section">
  <label>Fuente (Google Fonts):</label>
  <select id="fontSelector">
    <option value="Inter">Inter</option>
    <option value="Poppins">Poppins</option>
    <option value="Roboto">Roboto</option>
    <option value="Montserrat">Montserrat</option>
    <option value="Orbitron">Orbitron</option>
  </select>
</div>

<div class="section">
  <label>Color primario:</label>
  <input type="color" id="primaryColor" value="#8A2BE2">
</div>

<div class="section">
  <label>Color secundario:</label>
  <input type="color" id="secondaryColor" value="#0D0D16">
</div>

<div class="section">
  <label>Color acento:</label>
  <input type="color" id="accentColor" value="#9B59B6">
</div>

<div class="section">
  <label>Subir CSS personalizado:</label>
  <input type="file" id="cssUpload">
</div>

<div class="section">
  <label>Subir logo:</label>
  <input type="file" id="logoUpload">
</div>

<div class="section">
  <label>Subir banner:</label>
  <input type="file" id="bannerUpload">
</div>

<button id="applyBtn">Aplicar Tema</button>

<script src="theme.js"></script>

</body>
</html>

FILE: theme.css
----------------------------------------
body {
  background: #0D0D16;
  color: white;
  font-family: 'Inter', sans-serif;
}

h1 {
  color: #8A2BE2;
  margin-bottom: 20px;
}

.section {
  margin-bottom: 20px;
}

button {
  background: #8A2BE2;
  color: white;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  margin-top: 20px;
}

button:hover {
  background: #9B59B6;
}

FILE: theme.js
----------------------------------------
function applyTheme() {
  const primary = document.getElementById("primaryColor").value;
  const secondary = document.getElementById("secondaryColor").value;
  const accent = document.getElementById("accentColor").value;
  const font = document.getElementById("fontSelector").value;

  document.body.style.background = secondary;
  document.body.style.color = "white";

  document.querySelector("h1").style.color = primary;

  document.getElementById("googleFont").href =
    "https://fonts.googleapis.com/css2?family=" + font.replace(" ", "+") + ":wght@300;400;600&display=swap";

  document.body.style.fontFamily = font + ", sans-serif";

  alert("Tema aplicado con éxito (versión PRO)");
}

document.getElementById("applyBtn").onclick = applyTheme;
